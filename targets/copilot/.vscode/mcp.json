{
  "servers": {
    "sloom": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp[cli]>=1.2,<2",
        "python",
        "${workspaceFolder}/mcp/mcp_server.py"
      ],
      "env": {
        "SPINDLELOOM_SPEC_ROOT": "${workspaceFolder}"
      }
    }
  }
}
